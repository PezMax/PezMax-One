<Page
    x:Class="PezMax.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource PezBackgroundBrush}">

    <Grid>
        <muxc:NavigationView
            x:Name="Nav"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="420"
            ExpandedModeThresholdWidth="640"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="True"
            ItemInvoked="NavItemInvoked"
            OpenPaneLength="240"
            PaneDisplayMode="Auto">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="首页" Tag="home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemHeader Content="资料库" />
                <muxc:NavigationViewItem Content="资料" Tag="browse">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="社区" Tag="community">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE716;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemHeader Content="我的" />
                <muxc:NavigationViewItem Content="上传" Tag="upload">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE898;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem
                    x:Name="AccountItem"
                    Content="登录"
                    SelectsOnInvoked="False"
                    Tag="account">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,8,12,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        KeyDown="SearchKeyDown"
                        PlaceholderText="搜索资料"
                        CornerRadius="0" />
                    <Button Grid.Column="1" Click="SearchClick" Content="搜索" />
                </Grid>

                <!-- 滚动提醒：一条窄条，可关闭；多条时用左右切换 -->
                <Border
                    x:Name="ScrollNoticeHost"
                    Grid.Row="1"
                    Margin="12,0,12,4"
                    Padding="12,6"
                    Background="{ThemeResource PezSurfaceAltBrush}"
                    BorderBrush="{ThemeResource PezBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ScrollNoticeText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource PezBodyStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="1"
                            Click="ScrollNoticeNextClick"
                            ToolTipService.ToolTip="下一条">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="ScrollNoticeCloseClick"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 有新版时的一条提示：不弹模态框、不打断阅读（docs/RELEASES.md） -->
                <muxc:InfoBar
                    x:Name="UpdateBar"
                    Grid.Row="2"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational">
                    <muxc:InfoBar.ActionButton>
                        <Button Click="UpdateInstallClick" Content="去安装" />
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>

                <muxc:InfoBar
                    x:Name="SessionBar"
                    Grid.Row="3"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning">
                    <muxc:InfoBar.ActionButton>
                        <Button Click="SessionLoginClick" Content="重新登录" />
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="4" />

                <!-- 下载浮层：串行队列里正在下的那一个，可取消 -->
                <Border
                    x:Name="DownloadHost"
                    Grid.Row="4"
                    Margin="12,0,12,10"
                    Padding="12,8"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource PezSurfaceBrush}"
                    BorderBrush="{ThemeResource PezBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                x:Name="DownloadFileText"
                                Style="{StaticResource PezCaptionStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="DownloadBar" Maximum="1" Minimum="0" Value="0" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="DownloadCancelClick"
                            Content="取消" />
                    </Grid>
                </Border>
            </Grid>
        </muxc:NavigationView>

        <Grid
            x:Name="AppTitleBar"
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="1">
            <StackPanel
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Name="AppTitle"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PezTextSecondaryBrush}"
                    Text="PezMax One" />
            </StackPanel>
            <StackPanel
                Margin="0,0,140,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="NoticeBell"
                    Click="NoticeBellClick"
                    Padding="6,2"
                    ToolTipService.ToolTip="通知">
                    <Grid>
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE7ED;" />
                        <muxc:InfoBadge
                            x:Name="NoticeBadge"
                            Margin="10,-8,-10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
