<Page
    x:Class="PezMax.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:PezMax.Core.Models"
    Background="{ThemeResource PezBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,40" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PezPageTitleStyle}" Text="欢迎" />
                <TextBlock
                    x:Name="WelcomeCaption"
                    Style="{StaticResource PezCaptionStyle}"
                    Text="拼图满绩 · 学习资料" />
            </StackPanel>

            <muxc:InfoBar
                x:Name="ErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="220" Style="{StaticResource PezCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="UploadValue" Style="{StaticResource PezMetricStyle}" Text="0" />
                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="上传资料" />
                    </StackPanel>
                </Border>
                <Border Width="220" Style="{StaticResource PezCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DownloadValue" Style="{StaticResource PezMetricStyle}" Text="0" />
                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="下载次数" />
                    </StackPanel>
                </Border>
                <Border Width="220" Style="{StaticResource PezCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FavoriteValue" Style="{StaticResource PezMetricStyle}" Text="0" />
                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="收藏" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource PezSectionTitleStyle}" Text="快速入口" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BrowseClick" Content="浏览资料" Style="{StaticResource AccentButtonStyle}" />
                    <Button Click="FavoritesClick" Content="我的收藏" />
                    <Button Click="DownloadsClick" Content="下载记录" />
                    <Button Click="SettingsClick" Content="设置" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource PezSectionTitleStyle}" Text="最近资料" />
                    <ProgressRing
                        x:Name="RecentProgress"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Right"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="RecentList"
                    MaxHeight="420"
                    SelectionMode="None"
                    ItemContainerTransitions="{x:Null}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileItem">
                            <Grid Padding="4,8" ColumnSpacing="16" AutomationProperties.Name="{x:Bind DisplayName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SubjectSchoolText}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PezCaptionStyle}"
                                    Text="{x:Bind TypeName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PezCaptionStyle}"
                                    Text="{x:Bind SizeText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PezCaptionStyle}"
                                    Text="{x:Bind YearText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="RecentEmpty"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PezCaptionStyle}"
                    Text="还没有可显示的资料"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
