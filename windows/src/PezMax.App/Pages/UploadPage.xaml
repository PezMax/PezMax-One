<Page
    x:Class="PezMax.Pages.UploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:transfer="using:PezMax.Transfer"
    Background="{ThemeResource PezBackgroundBrush}">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="上传资料" />
            <TextBlock
                Style="{StaticResource PezCaptionStyle}"
                Text="提交后进入审核，通过后才公开。doc / docx / ppt / pptx 会转换成 PDF 存储；txt / md 仅支持 UTF-8。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SubjectBox"
                Grid.Column="0"
                Header="科目（必填，≤ 64 字节）"
                PlaceholderText="数学" />
            <AutoSuggestBox
                x:Name="SchoolBox"
                Grid.Column="1"
                Header="学校"
                PlaceholderText="实验中学"
                TextChanged="SchoolTextChanged" />
            <TextBox
                x:Name="YearBox"
                Grid.Column="2"
                Header="年份"
                CornerRadius="0" />
            <ComboBox x:Name="TypeBox" Grid.Column="3" Header="类型" CornerRadius="0" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="PickFilesClick" Content="选择文件…" />
            <Button Click="PickFolderClick" Content="选择文件夹…" />
            <Button x:Name="StartButton" Click="StartClick" Content="开始上传" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Click="CancelClick" Content="取消" Visibility="Collapsed" />
            <Button x:Name="ClearButton" Click="ClearClick" Content="清空" />
            <ProgressRing
                x:Name="BusyRing"
                Width="18"
                Height="18"
                IsActive="False"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                Style="{StaticResource PezCaptionStyle}" />
        </StackPanel>

        <ListView
            x:Name="FileList"
            Grid.Row="3"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="transfer:UploadItem">
                    <Grid Padding="0,6" RowSpacing="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource PezCaptionStyle}"
                                Text="{x:Bind SizeText}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource PezCaptionStyle}"
                            Text="{x:Bind Hint}"
                            TextWrapping="Wrap" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                            <ProgressBar
                                Width="180"
                                Height="4"
                                VerticalAlignment="Center"
                                Maximum="1"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource PezCaptionStyle}"
                                Text="{x:Bind Status, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <muxc:InfoBar
            x:Name="UploadBar"
            Grid.Row="4"
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />
    </Grid>
</Page>
