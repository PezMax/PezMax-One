<Page
    x:Class="PezMax.Pages.UploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:PezMax.Core.Models"
    xmlns:reader="using:PezMax.Reader"
    xmlns:transfer="using:PezMax.Transfer"
    Background="{ThemeResource PezBackgroundBrush}">

    <Grid>
        <Pivot
            x:Name="Tabs"
            Margin="32,28,32,24"
            SelectionChanged="TabSelectionChanged">

            <PivotItem Header="上传">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                        <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="上传资料" />
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            Text="提交后进入审核，通过后才公开。doc / docx / ppt / pptx 会转换成 PDF 存储；txt / md 仅支持 UTF-8。" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox
                            x:Name="SubjectBox"
                            Grid.Column="0"
                            Header="科目（必填，≤ 64 字节）"
                            PlaceholderText="数学" />
                        <AutoSuggestBox
                            x:Name="SchoolBox"
                            Grid.Column="1"
                            Header="学校"
                            PlaceholderText="实验中学"
                            TextChanged="SchoolTextChanged" />
                        <TextBox
                            x:Name="YearBox"
                            Grid.Column="2"
                            Header="年份"
                            CornerRadius="0" />
                        <ComboBox
                            x:Name="TypeBox"
                            Grid.Column="3"
                            Header="类型"
                            CornerRadius="0" />
                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="PickFilesClick" Content="选择文件…" />
                        <Button Click="PickFolderClick" Content="选择文件夹…" />
                        <Button
                            x:Name="StartButton"
                            Click="StartClick"
                            Content="开始上传"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="CancelButton"
                            Click="CancelClick"
                            Content="取消"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="ClearButton"
                            Click="ClearClick"
                            Content="清空" />
                        <ProgressRing
                            x:Name="BusyRing"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SummaryText"
                            VerticalAlignment="Center"
                            Style="{StaticResource PezCaptionStyle}" />
                    </StackPanel>

                    <ListView
                        x:Name="FileList"
                        Grid.Row="3"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="transfer:UploadItem">
                                <Grid Padding="0,6" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource PezBodyStyle}"
                                            Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource PezCaptionStyle}"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource PezCaptionStyle}"
                                        Text="{x:Bind Hint}"
                                        TextWrapping="Wrap" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                        <ProgressBar
                                            Width="180"
                                            Height="4"
                                            VerticalAlignment="Center"
                                            Maximum="1"
                                            Value="{x:Bind Progress, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PezCaptionStyle}"
                                            Text="{x:Bind Status, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <muxc:InfoBar
                        x:Name="UploadBar"
                        Grid.Row="4"
                        Margin="0,8,0,0"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />
                </Grid>
            </PivotItem>

            <PivotItem Header="我的上传">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock
                            x:Name="MineCaption"
                            VerticalAlignment="Center"
                            Style="{StaticResource PezCaptionStyle}"
                            Text="我提交的资料（含待审与未通过）" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                x:Name="MineRing"
                                Width="18"
                                Height="18"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button Click="RefreshMineClick" Content="刷新" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="MineList"
                        Grid.Row="1"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource PezBodyStyle}"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource PezSurfaceAltBrush}">
                                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind StatusText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SubjectSchoolText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind TypeName}" />
                                            <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind YearText}" />
                                            <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SizeText}" />
                                            <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind CreateTime}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            Padding="10,4"
                                            Click="PreviewMineClick"
                                            Content="预览"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Padding="10,4"
                                            Click="EditMineClick"
                                            Content="编辑"
                                            Tag="{x:Bind}" />
                                        <Button
                                            Padding="10,4"
                                            Click="DeleteMineClick"
                                            Content="删除"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <muxc:InfoBar
                        x:Name="MineBar"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />
                </Grid>
            </PivotItem>
        </Pivot>

        <Grid x:Name="ReaderOverlay" Background="{ThemeResource PezBackgroundBrush}" Visibility="Collapsed">
            <reader:PdfReader x:Name="PdfHost" />
        </Grid>
    </Grid>
</Page>
