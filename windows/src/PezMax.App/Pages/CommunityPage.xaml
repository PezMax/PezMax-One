<Page
    x:Class="PezMax.Pages.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:PezMax.Core.Models"
    Background="{ThemeResource PezBackgroundBrush}">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="社区" />
            <TextBlock Style="{StaticResource PezCaptionStyle}" Text="排行、贡献与举报记录" />
        </StackPanel>

        <Pivot Grid.Row="1">
            <PivotItem Header="用户排行">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Click="RefreshRankClick" Content="刷新" />
                        <ProgressRing
                            x:Name="RankProgress"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ListView x:Name="RankList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RankEntry">
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource PezMetricStyle}" FontSize="20" Text="{x:Bind UserIdText}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind UserName}" />
                                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Avatar}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PezCaptionStyle}" Text="{x:Bind UploadsText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="贡献文件">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PezSectionTitleStyle}" Text="上传资料" />
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            Text="支持 doc/docx/ppt/pptx/pdf/jpg/png/webp/txt/md/epub/mobi/azw3；Office 会自动转 PDF，TXT/MD 必须 UTF-8。上传后进入待审。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PickFilesButton" Click="PickFilesClick" Content="选择文件" Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock x:Name="PickedText" VerticalAlignment="Center" Style="{StaticResource PezCaptionStyle}" Text="尚未选择文件" />
                        </StackPanel>
                        <TextBox x:Name="UploadSubjectBox" Header="科目（必填）" Width="360" CornerRadius="0" />
                        <TextBox x:Name="UploadSchoolBox" Header="学校" Width="360" CornerRadius="0" />
                        <TextBox x:Name="UploadYearBox" Header="年份（1900–2100）" Width="360" Text="2026" CornerRadius="0" />
                        <ComboBox x:Name="UploadTypeBox" Header="类型" Width="240" SelectedIndex="0" CornerRadius="0" />
                        <Button Click="UploadClick" Content="开始上传" />
                        <ProgressRing
                            x:Name="UploadProgress"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Left"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <muxc:InfoBar x:Name="UploadBar" IsClosable="True" IsOpen="False" Severity="Informational" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="举报记录">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Click="RefreshReportsClick" Content="刷新" />
                        <Button Click="TimelineClick" Content="查看时间线" />
                        <ProgressRing
                            x:Name="ReportProgress"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ListView x:Name="ReportList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReportItem">
                                <StackPanel Padding="2,8" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind KindText}" />
                                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind ResultName}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Reason}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind CreateTime}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
