<UserControl
    x:Class="PezMax.Pages.Browse.PapersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:reader="using:PezMax.Reader"
    xmlns:models="using:PezMax.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                KeyDown="SearchKeyDown"
                PlaceholderText="搜索文件名、科目、学校"
                CornerRadius="0" />
            <Button Grid.Column="1" Click="SearchClick" Content="搜索" />
            <Button Grid.Column="2" Click="RefreshClick" Content="刷新" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="4,0,0,6"
                    Style="{StaticResource PezCaptionStyle}"
                    Text="文件树" />
                <muxc:TreeView
                    x:Name="Tree"
                    Grid.Row="1"
                    ItemInvoked="TreeItemInvoked" />
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock x:Name="ListCaption" Style="{StaticResource PezCaptionStyle}" Text="资料列表" />
                    <ProgressRing
                        x:Name="ListProgress"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    SelectionChanged="FileSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileItem">
                            <StackPanel Padding="2,6" Spacing="2">
                                <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" />
                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SubjectSchoolText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind TypeName}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SizeText}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind YearText}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource PezSectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource PezCaptionStyle}" />
                    <TextBlock x:Name="DetailStatus" Style="{StaticResource PezCaptionStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="PreviewClick" Content="预览" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="DownloadClick" Content="下载" />
                        <Button x:Name="FavoriteButton" Click="FavoriteClick" Content="收藏" />
                        <Button Click="ReportClick" Content="举报" />
                        <Button Click="CopyLinkClick" Content="复制链接" />
                    </StackPanel>

                    <ProgressRing
                        x:Name="PreviewProgress"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <muxc:InfoBar x:Name="PreviewError" IsClosable="False" IsOpen="False" Severity="Error" />
                    <Border
                        x:Name="PreviewHost"
                        MinHeight="240"
                        Background="{ThemeResource PezSurfaceAltBrush}"
                        BorderBrush="{ThemeResource PezBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <ScrollViewer x:Name="PreviewTextHost" Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PreviewText"
                                    Margin="16"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="ReaderOverlay"
            Grid.RowSpan="2"
            Background="{ThemeResource PezBackgroundBrush}"
            Visibility="Collapsed">
            <reader:PdfReader x:Name="PdfHost" />
        </Grid>
    </Grid>
</UserControl>
