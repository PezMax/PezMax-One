<UserControl
    x:Class="PezMax.Pages.Browse.PapersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:reader="using:PezMax.Reader"
    xmlns:models="using:PezMax.Core.Models">

    <!-- 找试卷的流程按旧 egui 版：先选条件（科目 / 学校 / 年份 / 类型）再出列表，
         不做文件树。用户是来找某一份卷子的，不是来逛目录的。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                KeyDown="SearchKeyDown"
                CornerRadius="0"
                PlaceholderText="搜索文件名、科目、学校" />
            <Button Grid.Column="1" Click="SearchClick" Content="搜索" />
            <Button Grid.Column="2" Click="RefreshClick" Content="刷新" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="SubjectFilter"
                Width="150"
                Header="科目"
                PlaceholderText="全部科目"
                SelectionChanged="FilterChanged" />
            <ComboBox
                x:Name="SchoolFilter"
                Width="170"
                Header="学校"
                PlaceholderText="全部学校"
                SelectionChanged="FilterChanged" />
            <ComboBox
                x:Name="YearFilter"
                Width="110"
                Header="年份"
                PlaceholderText="全部年份"
                SelectionChanged="FilterChanged" />
            <ComboBox
                x:Name="TypeFilter"
                Width="120"
                Header="类型"
                PlaceholderText="全部类型"
                SelectionChanged="FilterChanged" />
            <Button
                Margin="0,24,0,0"
                VerticalAlignment="Top"
                Click="ClearFiltersClick"
                Content="清除筛选" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock x:Name="ListCaption" Style="{StaticResource PezCaptionStyle}" Text="资料列表" />
                    <ProgressRing
                        x:Name="ListProgress"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    SelectionChanged="FileSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileItem">
                            <!-- 列表项的自动化名字：不写的话读屏念的是类型全名
                                 （PezMax.Core.Models.FileItem），看不出来但听得出来。 -->
                            <StackPanel
                                Padding="2,6"
                                Spacing="2"
                                AutomationProperties.Name="{x:Bind DisplayName}">
                                <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" />
                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SubjectSchoolText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind TypeName}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SizeText}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind YearText}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- 空态：没选条件、选了但没结果，都要有话说。
                     这块占着列表那一行，不抢点击（IsHitTestVisible=False）。 -->
                <TextBlock
                    x:Name="ListEmpty"
                    Grid.Row="1"
                    Margin="4,14,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Style="{StaticResource PezCaptionStyle}"
                    Text="挑一两个条件，或者直接搜文件名"
                    TextWrapping="Wrap" />
            </Grid>

            <!-- 详情栏的 ScrollViewer 必须关掉横向滚动：默认允许横滚时内容是按无限宽测量的，
                 TextWrapping 形同虚设，信息行会被右边缘切掉。 -->
            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource PezSectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource PezCaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailStatus" Style="{StaticResource PezCaptionStyle}" TextWrapping="Wrap" />

                    <!-- 五个按钮排一行在 300 宽里放不下，「复制链接」会被切掉；两列铺开。 -->
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Click="PreviewClick"
                            Content="预览"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="DownloadClick"
                            Content="下载" />
                        <Button
                            x:Name="FavoriteButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Click="FavoriteClick"
                            Content="收藏" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="ReportClick"
                            Content="举报" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Click="CopyLinkClick"
                            Content="复制链接" />
                    </Grid>

                    <ProgressRing
                        x:Name="PreviewProgress"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <muxc:InfoBar x:Name="PreviewError" IsClosable="False" IsOpen="False" Severity="Error" />
                    <Border
                        x:Name="PreviewHost"
                        MinHeight="240"
                        Background="{ThemeResource PezSurfaceAltBrush}"
                        BorderBrush="{ThemeResource PezBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <ScrollViewer x:Name="PreviewTextHost" Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PreviewText"
                                    Margin="16"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="ReaderOverlay"
            Grid.RowSpan="3"
            Background="{ThemeResource PezBackgroundBrush}"
            Visibility="Collapsed">
            <reader:PdfReader x:Name="PdfHost" />
        </Grid>
    </Grid>
</UserControl>
