<UserControl
    x:Class="PezMax.Pages.Browse.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:PezMax.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="Caption" Style="{StaticResource PezCaptionStyle}" Text="我的收藏" />
            <ProgressRing
                x:Name="Progress"
                Width="18"
                Height="18"
                HorizontalAlignment="Right"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <Pivot x:Name="Tabs" Grid.Row="1" SelectionChanged="TabChanged">
            <PivotItem Header="资料">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="FileList" Grid.Row="0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <StackPanel Padding="2,6" Spacing="2" AutomationProperties.Name="{x:Bind DisplayName}">
                                    <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SubjectSchoolText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Click="OpenFileClick" Content="下载" />
                        <Button Click="RemoveFileClick" Content="取消收藏" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="电子书">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="EbookList" Grid.Row="0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EbookItem">
                                <StackPanel Padding="2,6" Spacing="2" AutomationProperties.Name="{x:Bind DisplayName}">
                                    <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind EbookSubject}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Click="DownloadEbookClick" Content="下载" />
                        <Button Click="RemoveEbookClick" Content="取消收藏" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="书签">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="BookmarkList" Grid.Row="0" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Bookmark">
                                <StackPanel Padding="2,6" Spacing="2" AutomationProperties.Name="{x:Bind Title}">
                                    <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Url}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Click="OpenBookmarkClick" Content="打开链接" />
                        <Button Click="RemoveBookmarkClick" Content="取消收藏" />
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>

        <muxc:InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</UserControl>
