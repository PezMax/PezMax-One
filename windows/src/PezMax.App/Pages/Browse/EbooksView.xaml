<UserControl
    x:Class="PezMax.Pages.Browse.EbooksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:reader="using:PezMax.Reader"
    xmlns:models="using:PezMax.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" KeyDown="SearchKeyDown" PlaceholderText="搜索书名、作者、出版社" CornerRadius="0" />
            <Button Grid.Column="1" Click="SearchClick" Content="搜索" />
            <Button Grid.Column="2" Click="UploadClick" Content="上传电子书" Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="3" Click="RefreshClick" Content="刷新" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock x:Name="ListCaption" Style="{StaticResource PezCaptionStyle}" Text="电子书" />
                    <ProgressRing
                        x:Name="ListProgress"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="BookList"
                    Grid.Row="1"
                    SelectionChanged="BookSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:EbookItem">
                            <StackPanel Padding="2,6" Spacing="2">
                                <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Author}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind EbookSubject}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind SizeText}" />
                                    <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind EbookFormat}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image x:Name="CoverImage" Width="120" Height="160" Stretch="UniformToFill" />
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource PezSectionTitleStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailMeta" Style="{StaticResource PezCaptionStyle}" />
                            <TextBlock x:Name="DetailPublisher" Style="{StaticResource PezCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="PreviewClick" Content="预览" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="DownloadClick" Content="下载" />
                        <Button x:Name="FavoriteButton" Click="FavoriteClick" Content="收藏" />
                        <Button Click="ReportClick" Content="举报" />
                    </StackPanel>

                    <muxc:InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

                    <ProgressRing
                        x:Name="PreviewProgress"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="PreviewHost"
                        MinHeight="320"
                        Background="{ThemeResource PezSurfaceAltBrush}"
                        BorderBrush="{ThemeResource PezBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="PreviewHint" Style="{StaticResource PezCaptionStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="ReaderOverlay"
            Grid.RowSpan="2"
            Background="{ThemeResource PezBackgroundBrush}"
            Visibility="Collapsed">
            <reader:PdfReader x:Name="PdfHost" />
        </Grid>

        <Grid
            x:Name="EpubOverlay"
            Grid.RowSpan="2"
            Background="{ThemeResource PezBackgroundBrush}"
            Visibility="Collapsed">
            <reader:EpubReader x:Name="EpubHost" />
        </Grid>
    </Grid>
</UserControl>
