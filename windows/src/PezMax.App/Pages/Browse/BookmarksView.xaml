<UserControl
    x:Class="PezMax.Pages.Browse.BookmarksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:PezMax.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" KeyDown="SearchKeyDown" PlaceholderText="搜索书签标题、描述或网址" CornerRadius="0" />
            <Button Grid.Column="1" Click="SearchClick" Content="搜索" />
            <Button Grid.Column="2" Click="CreateClick" Content="新建书签" Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="3" Click="RefreshClick" Content="刷新" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,0,6">
                    <TextBlock x:Name="ListCaption" Style="{StaticResource PezCaptionStyle}" Text="书签" />
                    <ProgressRing
                        x:Name="ListProgress"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="BookmarkList"
                    Grid.Row="1"
                    SelectionChanged="BookmarkSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Bookmark">
                            <StackPanel Padding="2,6" Spacing="2">
                                <TextBlock Style="{StaticResource PezBodyStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource PezCaptionStyle}" Text="{x:Bind Collection}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource PezSectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailUrl" Style="{StaticResource PezCaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailDescription" Style="{StaticResource PezBodyStyle}" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource PezCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OpenClick" Content="打开链接" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="EditClick" Content="编辑" />
                        <Button Click="CoverClick" Content="上传封面" />
                        <Button Click="FavoriteClick" Content="收藏" />
                        <Button Click="ReportClick" Content="举报" />
                        <Button Click="DeleteClick" Content="删除" />
                    </StackPanel>
                    <muxc:InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />
                    <Image
                        x:Name="CoverImage"
                        MaxHeight="280"
                        HorizontalAlignment="Left"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
