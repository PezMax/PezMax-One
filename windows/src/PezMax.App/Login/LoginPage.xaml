<Page
    x:Class="PezMax.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource PezBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="420"
                Margin="24,48,24,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Image Width="56" Height="56" Source="ms-appx:///Assets/Square150x150Logo.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="PezMax One" />
                        <TextBlock Style="{StaticResource PezCaptionStyle}" Text="拼图满绩 · 学习资料客户端" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource PezCardStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource PezSectionTitleStyle}" Text="登录" />

                        <TextBox
                            x:Name="UsernameBox"
                            Header="用户名"
                            KeyDown="InputKeyDown"
                            PlaceholderText="请输入用户名"
                            CornerRadius="0" />

                        <PasswordBox
                            x:Name="PasswordBox"
                            Header="密码"
                            KeyDown="InputKeyDown"
                            PlaceholderText="请输入密码"
                            CornerRadius="0" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CodeBox"
                                Grid.Column="0"
                                Header="验证码"
                                KeyDown="InputKeyDown"
                                MaxLength="6"
                                PlaceholderText="6 位数字"
                                CornerRadius="0" />
                            <Border
                                Grid.Column="1"
                                Height="32"
                                Margin="0,28,0,0"
                                Background="{ThemeResource PezSurfaceAltBrush}"
                                BorderBrush="{ThemeResource PezBorderBrush}"
                                BorderThickness="1"
                                Tapped="CaptchaTapped">
                                <Image x:Name="CaptchaImage" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <muxc:InfoBar
                            x:Name="ErrorBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Error" />

                        <Button
                            x:Name="LoginButton"
                            HorizontalAlignment="Stretch"
                            Click="LoginClick"
                            Content="登录"
                            Style="{StaticResource AccentButtonStyle}" />

                        <ProgressRing
                            x:Name="LoginProgress"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <HyperlinkButton Click="RegisterClick" Content="注册账号" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource PezCaptionStyle}"
                                Text="·" />
                            <HyperlinkButton Click="ForgotClick" Content="找回密码" />
                        </StackPanel>

                        <HyperlinkButton
                            x:Name="ServerLink"
                            HorizontalAlignment="Center"
                            Click="ServerClick" />

                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            Click="PreviewClick"
                            Content="进入主界面预览（离线）" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PezCaptionStyle}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="24,0,24,18"
            HorizontalAlignment="Center"
            Style="{StaticResource PezCaptionStyle}"
            Text="登录后可在「设置 → 高级」中修改服务器地址" />
    </Grid>
</Page>
