<UserControl
    x:Class="PezMax.Login.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource PezBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="460"
            Margin="24,40,24,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="注册账号" />
                <TextBlock x:Name="StepCaption" Style="{StaticResource PezCaptionStyle}" />
            </StackPanel>

            <Border Style="{StaticResource PezCardStyle}">
                <Grid>
                    <!-- 第一步：账号 -->
                    <StackPanel x:Name="AccountStep" Spacing="14">
                        <TextBox
                            x:Name="UserNameBox"
                            KeyDown="StepKeyDown"
                            Header="用户名"
                            PlaceholderText="最长 64 个字符，中英文均可" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            KeyDown="StepKeyDown"
                            Header="密码"
                            PlaceholderText="5 到 64 位" />
                        <PasswordBox
                            x:Name="ConfirmBox"
                            KeyDown="StepKeyDown"
                            Header="确认密码"
                            PlaceholderText="再输入一次密码" />
                        <muxc:InfoBar x:Name="AccountError" IsClosable="False" IsOpen="False" Severity="Error" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Click="CancelClick" Content="取消" />
                            <Button
                                Click="AccountNextClick"
                                Content="下一步"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 第二步：密保问题 -->
                    <StackPanel x:Name="SecurityStep" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            Text="密保用于找回密码，答案在服务端做哈希存储。三组问题与答案都要填，答案请自己记住。" />
                        <TextBox x:Name="QuestionOneBox" Header="密保问题一" />
                        <TextBox x:Name="AnswerOneBox" Header="答案一" />
                        <TextBox x:Name="QuestionTwoBox" Header="密保问题二" />
                        <TextBox x:Name="AnswerTwoBox" Header="答案二" />
                        <TextBox x:Name="QuestionThreeBox" Header="密保问题三" />
                        <TextBox x:Name="AnswerThreeBox" Header="答案三" />
                        <muxc:InfoBar x:Name="SecurityError" IsClosable="False" IsOpen="False" Severity="Error" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Click="SecurityBackClick" Content="上一步" />
                            <Button
                                Click="SecurityNextClick"
                                Content="下一步"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 第三步：验证码 -->
                    <StackPanel x:Name="CaptchaStep" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            Text="验证码一次性有效：提交失败（含用户名已被占用）后都要换一张，点图片可刷新。" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CodeBox"
                                Grid.Column="0"
                                KeyDown="StepKeyDown"
                                Header="验证码"
                                MaxLength="6"
                                PlaceholderText="6 位数字" />
                            <Border
                                Grid.Column="1"
                                Height="32"
                                Margin="0,28,0,0"
                                Background="{ThemeResource PezSurfaceAltBrush}"
                                BorderBrush="{ThemeResource PezBorderBrush}"
                                BorderThickness="1"
                                Tapped="CaptchaTapped">
                                <Image x:Name="CaptchaImage" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <muxc:InfoBar x:Name="CaptchaError" IsClosable="False" IsOpen="False" Severity="Error" />
                        <ProgressRing
                            x:Name="SubmitProgress"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Click="CaptchaBackClick" Content="上一步" />
                            <Button
                                x:Name="SubmitButton"
                                Click="SubmitClick"
                                Content="完成注册"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 完成 -->
                    <StackPanel x:Name="DoneStep" Spacing="14" Visibility="Collapsed">
                        <muxc:InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="注册成功，请用新账号登录。"
                            Severity="Success" />
                        <TextBlock x:Name="DoneHint" Style="{StaticResource PezBodyStyle}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="DoneClick"
                                Content="回到登录"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
