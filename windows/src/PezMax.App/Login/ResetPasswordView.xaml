<UserControl
    x:Class="PezMax.Login.ResetPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource PezBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Width="460"
            Margin="24,40,24,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PezPageTitleStyle}" Text="找回密码" />
                <TextBlock x:Name="StepCaption" Style="{StaticResource PezCaptionStyle}" />
            </StackPanel>

            <Border Style="{StaticResource PezCardStyle}">
                <Grid>
                    <!-- 第一步：用户名 + 验证码，换取密保问题（同时签发重置工单） -->
                    <StackPanel x:Name="VerifyStep" Spacing="14">
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            TextWrapping="Wrap"
                            Text="先验证身份：填用户名与验证码，通过后显示该账号的密保问题。验证码一次性有效，点图片可刷新。" />
                        <TextBox
                            x:Name="UserNameBox"
                            KeyDown="VerifyKeyDown"
                            Header="用户名" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CodeBox"
                                Grid.Column="0"
                                KeyDown="VerifyKeyDown"
                                Header="验证码"
                                MaxLength="6"
                                PlaceholderText="6 位数字" />
                            <Border
                                Grid.Column="1"
                                Height="32"
                                Margin="0,28,0,0"
                                Background="{ThemeResource PezSurfaceAltBrush}"
                                BorderBrush="{ThemeResource PezBorderBrush}"
                                BorderThickness="1"
                                Tapped="CaptchaTapped">
                                <Image x:Name="CaptchaImage" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <muxc:InfoBar x:Name="VerifyError" IsClosable="False" IsOpen="False" Severity="Error" />
                        <ProgressRing
                            x:Name="VerifyProgress"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Click="CancelClick" Content="取消" />
                            <Button
                                x:Name="VerifyButton"
                                Click="VerifyClick"
                                Content="下一步"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 第二步：密保答案 + 新密码 -->
                    <StackPanel x:Name="AnswerStep" Spacing="14" Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource PezCaptionStyle}"
                            TextWrapping="Wrap"
                            Text="回答密保问题并设置新密码。工单一次性有效：答案错或提交失败都要回到第一步重新获取验证码。" />
                        <StackPanel x:Name="AnswersPanel" Spacing="10" />
                        <PasswordBox
                            x:Name="NewPasswordBox"
                            Header="新密码"
                            PlaceholderText="5 到 64 位" />
                        <PasswordBox
                            x:Name="ConfirmBox"
                            KeyDown="AnswerKeyDown"
                            Header="确认新密码"
                            PlaceholderText="再输入一次新密码" />
                        <muxc:InfoBar x:Name="AnswerError" IsClosable="False" IsOpen="False" Severity="Error" />
                        <ProgressRing
                            x:Name="ResetProgress"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Click="AnswerBackClick" Content="上一步" />
                            <Button
                                x:Name="ResetButton"
                                Click="ResetClick"
                                Content="重置密码"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 完成 -->
                    <StackPanel x:Name="DoneStep" Spacing="14" Visibility="Collapsed">
                        <muxc:InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="密码已重置，请用新密码登录。"
                            Severity="Success" />
                        <TextBlock
                            Style="{StaticResource PezBodyStyle}"
                            Text="密码变更后其他设备上的登录会立即失效，需要重新登录。" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="DoneClick"
                                Content="回到登录"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
