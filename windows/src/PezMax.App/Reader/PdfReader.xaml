<UserControl
    x:Class="PezMax.Reader.PdfReader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reader="using:PezMax.Reader"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource PezBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    x:Name="GridModeButton"
                    Click="GridModeClick"
                    Content="网格" />
                <ToggleButton
                    x:Name="LineModeButton"
                    Click="LineModeClick"
                    Content="连续" />
                <ToggleButton
                    x:Name="OverviewButton"
                    Click="OverviewClick"
                    Content="概览"
                    IsChecked="True" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="PageText"
                    VerticalAlignment="Center"
                    Style="{StaticResource PezCaptionStyle}" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="2"
                Margin="8,0"
                VerticalAlignment="Center"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource PezCaptionStyle}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button
                    Click="ZoomOutClick"
                    Content="−"
                    Padding="12,4"
                    ToolTipService.ToolTip="缩小" />
                <TextBlock
                    x:Name="ZoomText"
                    MinWidth="52"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource PezCaptionStyle}" />
                <Button
                    Click="ZoomInClick"
                    Content="+"
                    Padding="12,4"
                    ToolTipService.ToolTip="放大" />
                <Button Click="FitWidthClick" Content="适应宽度" />
                <Button Click="ResetZoomClick" Content="100%" />
            </StackPanel>

            <Button
                Grid.Column="4"
                Click="CloseClick"
                Content="关闭" />
        </Grid>

        <Grid Grid.Row="1">
            <GridView
                x:Name="GridHost"
                ContainerContentChanging="PageContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="GridItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="reader:PdfPageItem">
                        <Grid Width="{x:Bind TileWidth, Mode=OneWay}" Height="{x:Bind TileHeight, Mode=OneWay}">
                            <Border
                                Background="{ThemeResource PezSurfaceAltBrush}"
                                BorderBrush="{ThemeResource PezBorderBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PezCaptionStyle}"
                                        Text="{x:Bind Label}"
                                        Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="ContinuousHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="OverviewColumn" Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="OverviewList"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    ContainerContentChanging="PageContainerContentChanging"
                    IsItemClickEnabled="True"
                    ItemClick="OverviewItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="reader:PdfPageItem">
                            <StackPanel
                                Padding="0,4"
                                Spacing="2"
                                Width="112">
                                <Border
                                    Height="150"
                                    Background="{ThemeResource PezSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource PezBorderBrush}"
                                    BorderThickness="1">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PezCaptionStyle}"
                                    Text="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ScrollViewer
                    x:Name="Scroll"
                    Grid.Column="1"
                    HorizontalContentAlignment="Center"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ViewChanged="ScrollViewChanged"
                    ZoomMode="Disabled">
                    <ItemsControl x:Name="PageItemsControl" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 用 StackPanel 而不是 Canvas：Canvas.Top 要靠 Style 里的
                                     {Binding Top} 贴上去，实测没生效，所有页都叠在 (0,0)，
                                     看着像两张页拼在一起。页高已经由 HostHeight 给定，
                                     StackPanel + Spacing 出来的偏移与 PdfContinuousLayout 的
                                     Tops 完全一致，不需要再绑一次。 -->
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Width" Value="{Binding HostWidth}" />
                                <Setter Property="Height" Value="{Binding HostHeight}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="reader:PdfPageItem">
                                <Border
                                    Background="{ThemeResource PezSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource PezBorderBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PezCaptionStyle}"
                                            Text="{x:Bind Label}"
                                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <muxc:InfoBar
                x:Name="ErrorBar"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</UserControl>
