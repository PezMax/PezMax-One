<UserControl
    x:Class="PezMax.Reader.EpubReader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource PezBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button x:Name="TocButton" Content="目录">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <ListView
                                x:Name="TocList"
                                Width="360"
                                Height="420"
                                IsItemClickEnabled="True"
                                ItemClick="TocItemClick"
                                SelectionMode="None" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Click="PrevClick" x:Name="PrevButton" Content="上一章" />
                <Button Click="NextClick" x:Name="NextButton" Content="下一章" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="18"
                    Height="18"
                    IsActive="False"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                x:Name="ChapterText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource PezCaptionStyle}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <Button
                Grid.Column="3"
                Click="CloseClick"
                Content="关闭" />
        </Grid>

        <Grid Grid.Row="1">
            <muxc:WebView2 x:Name="View" />

            <muxc:InfoBar
                x:Name="ErrorBar"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</UserControl>
