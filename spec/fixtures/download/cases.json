[
  {
    "id": "download.before.no-part",
    "description": "没有半成品：直接从头请求，不带 Range / If-Range",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:568-573",
    "input": { "kind": "before", "part": { "size": 0 } },
    "expect": { "action": "start", "offset": 0, "discardPart": false }
  },
  {
    "id": "download.before.resume-with-strong-etag",
    "description": "半成品 + 强 ETag：带 Range 与 If-Range 续传",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:562-573",
    "input": { "kind": "before", "part": { "size": 1024, "etag": "\"datum-12-4096\"" } },
    "expect": {
      "action": "resume",
      "offset": 1024,
      "discardPart": false,
      "range": "bytes=1024-",
      "ifRange": "\"datum-12-4096\""
    }
  },
  {
    "id": "download.before.no-etag",
    "description": "半成品在但元数据没 ETag：无法校验，删掉重下，不发半个 If-Range",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:562-566",
    "input": { "kind": "before", "part": { "size": 1024 } },
    "expect": { "action": "restart", "offset": 0, "discardPart": true }
  },
  {
    "id": "download.before.weak-etag",
    "description": "只有弱 ETag（W/ 前缀）：If-Range 不接受弱校验器，按无法校验处理",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:562-566",
    "input": { "kind": "before", "part": { "size": 1024, "etag": "W/\"datum-12-4096\"" } },
    "expect": { "action": "restart", "offset": 0, "discardPart": true }
  },
  {
    "id": "download.response.200-fresh",
    "description": "全新下载、服务端回 200：按 Content-Length 作为总大小",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:568-573",
    "input": {
      "kind": "response",
      "part": { "size": 0 },
      "response": { "status": 200, "etag": "\"datum-12-4096\"", "contentLength": 4096 }
    },
    "expect": { "action": "start", "offset": 0, "total": 4096, "discardPart": false }
  },
  {
    "id": "download.response.200-ignores-range",
    "description": "续传时服务端回 200（If-Range 不匹配 / 被忽略）：必须截断重写，不能追加",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:568-573",
    "input": {
      "kind": "response",
      "part": { "size": 1024, "etag": "\"datum-12-4096\"" },
      "response": { "status": 200, "etag": "\"datum-12-9999\"", "contentLength": 9999 }
    },
    "expect": { "action": "restart", "offset": 0, "total": 9999, "discardPart": true }
  },
  {
    "id": "download.response.206-valid",
    "description": "半成品 1024 字节、ETag 一致、Content-Range 覆盖到末尾：可以续",
    "source": "PezMax-Go@061a888 k_admin/internal/kadmin/datum_activity.go:562-573",
    "input": {
      "kind": "response",
      "part": { "size": 1024, "etag": "\"datum-12-4096\"" },
      "response": {
        "status": 206,
        "etag": "\"datum-12-4096\"",
        "contentLength": 3072,
        "contentRange": "bytes 1024-4095/4096"
      }
    },
    "expect": { "action": "resume", "offset": 1024, "total": 4096, "discardPart": false }
  },
  {
