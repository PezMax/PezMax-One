[
  {
    "id": "envelope.success.object",
    "description": "成功对象：HTTP 200、code=0，data 为对象；解析为成功并保留 data",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/transport/httpx/response.go:8-15",
    "input": {
      "status": 200,
      "contentType": "application/json; charset=utf-8",
      "body": "{\"code\":0,\"message\":\"ok\",\"msg\":\"ok\",\"data\":{\"userId\":7,\"userName\":\"alice\"}}"
    },
    "expect": {
      "kind": "success",
      "code": 0,
      "data": { "userId": 7, "userName": "alice" },
      "session": "keep"
    }
  },
  {
    "id": "envelope.success.data-null",
    "description": "成功但 data 为 null（如成功写操作）仍按成功处理，不能当错误",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/transport/httpx/response.go:8-15",
    "input": {
      "status": 200,
      "contentType": "application/json",
      "body": "{\"code\":0,\"message\":\"ok\",\"msg\":\"ok\",\"data\":null}"
    },
    "expect": {
      "kind": "success",
      "code": 0,
      "data": null,
      "session": "keep"
    }
  },
  {
    "id": "envelope.success.list",
    "description": "列表成功：顶层 rows/total，没有 data；不得因缺少 data 报错",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_file.go:314-345",
    "input": {
      "status": 200,
      "contentType": "application/json",
      "body": "{\"code\":0,\"message\":\"ok\",\"msg\":\"ok\",\"rows\":[{\"fileId\":1},{\"fileId\":2}],\"total\":42}"
    },
    "expect": {
      "kind": "list",
      "code": 0,
      "rows": [{ "fileId": 1 }, { "fileId": 2 }],
      "total": 42,
      "dataAbsent": true,
      "session": "keep"
    }
  },
  {
    "id": "envelope.error.business",
    "description": "业务错误：HTTP 400 与 body.code 同为 400，优先取 msg 作为提示",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/transport/httpx/response.go:17-24",
    "input": {
      "status": 400,
      "contentType": "application/json",
      "body": "{\"code\":400,\"message\":\"用户名或密码错误\",\"msg\":\"用户名或密码错误\",\"data\":null}"
    },
    "expect": {
      "kind": "error",
      "code": 400,
      "message": "用户名或密码错误",
      "session": "keep",
      "retryable": false
    }
  },
  {
    "id": "envelope.error.msg-fallback-to-message",
    "description": "msg 为空时回落到 message；两者都空才用本地兜底",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/transport/httpx/response.go:17-24",
    "input": {
      "status": 409,
      "contentType": "application/json",
      "body": "{\"code\":409,\"message\":\"用户名已存在，请更换后重试\",\"msg\":\"\",\"data\":null}"
    },
    "expect": {
      "kind": "error",
      "code": 409,
      "message": "用户名已存在，请更换后重试",
      "session": "keep",
      "retryable": false
    }
  },
  {
    "id": "envelope.error.non-json-502",
    "description": "网关返回 HTML：HTTP 502 但正文不是 JSON；归为传输错误并保留会话",
    "source": "PezMax-Go@f79a4e0 deploy/nginx.conf.template（反代可能返回 HTML 错误页）；决策见 spec/api/envelope.md §2",
    "input": {
      "status": 502,
      "contentType": "text/html; charset=utf-8",
      "body": "<html><body>502 Bad Gateway</body></html>"
    },
    "expect": {
      "kind": "transport",
      "status": 502,
      "messageClass": "service-unavailable",
      "session": "keep",
      "retryable": true
    }
  },
  {
    "id": "envelope.error.401",
    "description": "401 是会话失效的唯一触发条件：清会话、回登录页，保留当前页",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_user_auth.go:462-489",
    "input": {
      "status": 401,
      "contentType": "application/json",
      "body": "{\"code\":401,\"message\":\"会话已过期，请重新登录\",\"msg\":\"会话已过期，请重新登录\",\"data\":null}"
    },
    "expect": {
      "kind": "session-expired",
      "code": 401,
      "message": "会话已过期，请重新登录",
      "session": "clear",
      "rememberRoute": true
    }
  },
  {
    "id": "envelope.error.401-account-disabled",
    "description": "账号被停用也走 401；照常清会话，并显示服务端给出的停用文案",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_user_auth.go:470-476",
    "input": {
      "status": 401,
      "contentType": "application/json",
      "body": "{\"code\":401,\"message\":\"账号已被停用，请重新登录\",\"msg\":\"账号已被停用，请重新登录\",\"data\":null}"
    },
    "expect": {
      "kind": "session-expired",
      "code": 401,
      "message": "账号已被停用，请重新登录",
      "session": "clear",
      "rememberRoute": true
    }
  },
  {
    "id": "envelope.error.401-non-json",
    "description": "代理层直接回 401 HTML 时同样清会话：401 不看正文是否可解析",
    "source": "spec/api/envelope.md §2 步骤 3",
    "input": {
      "status": 401,
      "contentType": "text/html",
      "body": "<html><body>401 Unauthorized</body></html>"
    },
    "expect": {
      "kind": "session-expired",
      "code": 401,
      "message": "",
      "session": "clear",
      "rememberRoute": true
    }
  },
  {
    "id": "envelope.error.code-nonzero-on-200",
    "description": "HTTP 200 但 code!=0 属异常形状；按业务错误处理，不得当成功",
    "source": "spec/api/envelope.md §2 步骤 9（防御性规则）",
    "input": {
      "status": 200,
      "contentType": "application/json",
      "body": "{\"code\":500,\"message\":\"内部错误\",\"msg\":\"内部错误\",\"data\":null}"
    },
    "expect": {
      "kind": "error",
      "code": 500,
      "message": "内部错误",
      "session": "keep",
      "retryable": false
    }
  },
  {
    "id": "envelope.state.unchanged-keeps-local",
    "description": "哈希命中：unchanged=true 且 data=null 时必须沿用本地 payload，不得清空",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_file.go:179-195",
    "input": {
      "status": 200,
      "contentType": "application/json",
      "body": "{\"code\":0,\"message\":\"ok\",\"msg\":\"ok\",\"data\":null,\"hash\":\"a1b2c3d4e5f60718\",\"unchanged\":true}"
    },
    "expect": {
      "kind": "state",
      "unchanged": true,
      "hash": "a1b2c3d4e5f60718",
      "data": null,
      "keepLocalPayload": true,
      "session": "keep"
    }
  },
  {
    "id": "envelope.state.changed-replaces",
    "description": "哈希未命中：返回完整 payload 与新 hash，整体替换本地缓存",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_file.go:179-195",
    "input": {
      "status": 200,
      "contentType": "application/json",
      "body": "{\"code\":0,\"message\":\"ok\",\"msg\":\"ok\",\"data\":[{\"id\":\"folder-1\",\"label\":\"数学\",\"type\":\"folder\",\"children\":[]}],\"hash\":\"0011223344556677\",\"unchanged\":false}"
    },
    "expect": {
      "kind": "state",
      "unchanged": false,
      "hash": "0011223344556677",
      "data": [{ "id": "folder-1", "label": "数学", "type": "folder", "children": [] }],
      "keepLocalPayload": false,
      "session": "keep"
    }
  },
  {
    "id": "envelope.stream.file",
    "description": "下载 / 预览是文件流，不按 JSON 信封解析；401 仍按会话失效处理",
    "source": "PezMax-Go@f79a4e0 k_admin/internal/kadmin/datum_activity.go:520-585",
    "input": {
      "status": 200,
      "contentType": "application/pdf",
      "bodyBase64": "JVBERi0xLjQK",
      "requestKind": "stream"
    },
    "expect": {
      "kind": "binary",
      "contentType": "application/pdf",
      "notJson": true,
      "session": "keep"
    }
  }
]
