    "sectionTitle": { "size": 20, "weight": "SemiLight", "color": "textPrimary" },
    "body": { "size": 14, "weight": "Normal", "color": "textPrimary", "wrap": true },
    "caption": { "size": 12, "weight": "Normal", "color": "textSecondary" },
    "metric": { "size": 32, "weight": "Light", "color": "textPrimary" }
