    },
    "surface": {
      "dark": "#181D23",
      "light": "#FFFFFF",
      "highContrast": "system:window"
    },
    "surfaceAlt": {
      "dark": "#20262E",
      "light": "#E9EDF2",
      "highContrast": "system:buttonFace"
    },
    "border": {
      "dark": "#2A313A",
      "light": "#D8DEE7",
      "highContrast": "system:windowText"
    },
    "textPrimary": {
      "dark": "#F5F7FA",
      "light": "#121820",
      "highContrast": "system:windowText"
    },
    "textSecondary": {
      "dark": "#A7B0BC",
      "light": "#4F5A67",
      "highContrast": "system:windowText"
    },
    "textTertiary": {
      "dark": "#737E8C",
      "light": "#7A8593",
      "highContrast": "system:windowText"
